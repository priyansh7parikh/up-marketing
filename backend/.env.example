# Copy to .env (never commit .env).
MONGO_URL=mongodb://127.0.0.1:27017/upmarketing
# At least 32 characters: openssl rand -hex 32
SESSION_SECRET=
# Used once, to create the first admin when the database has no users.
ADMIN_USER=admin
ADMIN_NAME=Owner
ADMIN_PASSWORD=
PORT=3000

# Optional (defaults shown)
# SESSION_DAYS=30          # how long a login lasts
# LOGIN_MAX_ATTEMPTS=10    # wrong passwords before lockout
# LOGIN_LOCK_MINUTES=15
# NODE_ENV=production      # set on the live server: turns on secure cookies
